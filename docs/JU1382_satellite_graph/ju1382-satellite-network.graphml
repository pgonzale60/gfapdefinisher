      <data key="arrays">[(5579, 6851, 6)]</data>
    </edge>
    <edge source="V_5p" target="S01">
      <data key="kind">local array</data>
      <data key="arrays">[(447, 738, 6)]</data>
    </edge>
    <node id="S02">
      <data key="label">S02 · 38 bp</data>
      <data key="kind">tandem marker group</data>
      <data key="caps">1</data>
    </node>
    <edge source="X_5p" target="S02">
      <data key="kind">local array</data>
      <data key="arrays">[(15919, 16732, 38)]</data>
    </edge>
    <node id="S03">
      <data key="label">S03 · 6 bp</data>
      <data key="kind">tandem marker group</data>
      <data key="caps">0</data>
    </node>
    <edge source="IV_3p" target="S03">
      <data key="kind">local array</data>
      <data key="arrays">[(454, 1024, 6)]</data>
    </edge>
    <node id="S04">
      <data key="label">S04 · 114 bp</data>
      <data key="kind">tandem marker group</data>
      <data key="caps">1</data>
    </node>
    <edge source="IV_5p" target="S04">
      <data key="kind">local array</data>
      <data key="arrays">[(1006, 1509, 114)]</data>
    </edge>
    <edge source="II_5p" target="V_3p">
      <data key="kind">competing read alignments</data>
      <data key="read_ids">daaf6427-e17a-4738-9a98-2df7662081a2, 9167bda3-9d80-4b73-976c-7aa4dfb2a2a4</data>
      <data key="read_links_between_ends">0</data>
      <data key="note">Each read supports the arm with the strongest inward alignment. Their distal homology does not establish a connection between arms.</data>
    </edge>
    <edge source="X_3p" target="X_5p">
      <data key="kind">competing read alignments</data>
      <data key="read_ids">a8760f5d-f703-49a4-9a4f-5c64db900dd6, 65531a55-544a-4fd2-8905-f603b34bb1f2, 03bf0ace-49c6-48c4-a7c1-9a4eac34b248</data>
      <data key="read_links_between_ends">0</data>
      <data key="note">These reads show shared terminal sequence. Whole-read placements distinguish the X 5′ junction from X 3′.</data>
    </edge>
    <edge source="I_3p" target="III_3p">
      <data key="kind">competing read alignments</data>
      <data key="read_ids">6d1ba12a-748d-48f0-9cac-b63876a3dc54, f36f7274-85a6-43ea-9a46-761701aaf892</data>
      <data key="read_links_between_ends">0</data>
      <data key="note">The I anchors are continuous through the I graph path. Segments in that path are homologous to the III end.</data>
    </edge>
    <edge source="I_5p" target="III_3p">
      <data key="kind">competing read alignments</data>
      <data key="read_ids">4536aba0-6fb1-4b61-ac68-c21aa526e5ed, f51f299f-f617-4eb5-910f-cd8fd6418405</data>
      <data key="read_links_between_ends">0</data>
      <data key="note">Both molecules have a long I anchor and repeat matches at III 3′ in reverse orientation.</data>
    </edge>
    <edge source="III_3p" target="II_3p">
      <data key="kind">competing read alignments</data>
      <data key="read_ids">ceeb5e9c-3de6-44c8-bec6-68d002744784, 1d5ccd10-095b-4e39-9f5c-ee71fe21de0d</data>
      <data key="read_links_between_ends">0</data>
      <data key="note">Long II anchors align through the extension, while repeat segments also map to III. Read segments link across repeats on the II path.</data>
    </edge>
    <edge source="IV_5p" target="V_5p">
      <data key="kind">competing read alignments</data>
      <data key="read_ids">bbd55af3-d34f-46f3-99ea-07fce67d4c5c, 52a4d909-174a-4e2d-a51b-c43adbe22bb6</data>
      <data key="read_links_between_ends">0</data>
      <data key="note">These apparent IV extension reads map for about 49 kb to V and were rejected for IV.</data>
    </edge>
